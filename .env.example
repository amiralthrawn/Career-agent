# Copy to .env and fill in locally. Never commit .env.

# Application
APP_ENV=development
APP_DEBUG=false

# Database (PostgreSQL) - full SQLAlchemy URL, e.g. postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Location of private candidate data (git-ignored). Relative to the project root or absolute.
PRIVATE_DATA_DIR=data/private

# Comma-separated list of allowed origins for the future frontend (e.g. the Next.js dev server)
CORS_ORIGINS=

# --- Local API security ---
# Bearer token required on every /api/* route. Generate it with:
#   python scripts/manage_secrets.py init-api-token
# (it writes the token here without displaying it). Minimum 32 characters. Never commit .env.
API_TOKEN=
# Host headers accepted by the API (DNS-rebinding protection).
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Outgoing e-mail (nothing is ever sent by default) ---
# disabled (default) | dry_run (writes .eml files to data/private/outbox/) | manual
# ("auto" is refused until a later step)
SEND_MODE=disabled
# Exact addresses a real send may target (comma-separated), e.g. your own address for tests.
SEND_ALLOWED_RECIPIENTS=
# Sender address of outgoing messages.
MAIL_FROM=
