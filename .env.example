# Copy to .env and fill in locally. Never commit .env.

# Application
APP_ENV=development
APP_DEBUG=false

# Database (PostgreSQL) - full SQLAlchemy URL, e.g. postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Location of private candidate data (git-ignored). Relative to the project root or absolute.
PRIVATE_DATA_DIR=data/private

# Comma-separated list of allowed origins for the future frontend (e.g. the Next.js dev server)
CORS_ORIGINS=

# --- Local API security ---
# Bearer token required on every /api/* route. Generate it with:
#   python scripts/manage_secrets.py init-api-token
# (it writes the token here without displaying it). Minimum 32 characters. Never commit .env.
API_TOKEN=
# Host headers accepted by the API (DNS-rebinding protection).
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Outgoing e-mail (nothing is ever sent by default) ---
# disabled (default) | dry_run (writes .eml files to data/private/outbox/) | manual (a narrow
# allow-list, for bootstrapping test sends to your own address) | auto (step 10: controlled batch
# sending - a real send still needs an explicitly approved ApplicationPackage AND an explicitly
# approved SendBatch; see docs/send_batches.md - no recipient allow-list in this mode)
SEND_MODE=disabled
# Exact addresses a real send may target in "manual" mode only (comma-separated); "auto" ignores
# this on purpose (see docs/send_batches.md).
SEND_ALLOWED_RECIPIENTS=
# Sender address of outgoing messages.
MAIL_FROM=

# --- LLM drafts (nothing is generated with a real model by default) ---
# Master switch. false (default): draft generation is refused (422) whatever the secret store
# holds. The API key itself is never here: python scripts/manage_secrets.py set openrouter_api_key
LLM_ENABLED=false
# Default model id passed to OpenRouter when a request does not name one, e.g. openai/gpt-4o-mini
OPENROUTER_MODEL=

# --- External research, Perplexity (nothing is researched with a real provider by default) ---
# Master switch. false (default): company research is refused whatever the secret store holds.
# The API key itself is never here: python scripts/manage_secrets.py set perplexity_api_key
RESEARCH_ENABLED=false
# Default preset/model id for a research call, e.g. low (see docs/providers.md)
PERPLEXITY_PRESET=

# --- GitHub public research, step 9 (nothing is researched with a real provider by default) ---
# Master switch. false (default): GitHub evidence is refused whatever the secret store holds.
# An optional token raises the rate limit only: python scripts/manage_secrets.py set github_token
GITHUB_ENABLED=false
# The candidate's own public GitHub username (see docs/application_workflow.md)
GITHUB_USERNAME=
